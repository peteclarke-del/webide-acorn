+
+int sound_dev_available(void)
+{
+	return audio_device != 0;
+}
+
+unsigned int sound_dev_queued_bytes(void)
+{
+	return audio_device ? SDL_GetQueuedAudioSize(audio_device) : 0;
+}
+
+int sound_capture_start(unsigned int seconds)
+{
+	unsigned int frames;
+	int16_t *replacement;
+	if (seconds < 1 || seconds > 30 || !audio_device) return 0;
+	frames = seconds * OUTPUT_FREQ;
+	replacement = calloc((size_t)frames * 2, sizeof(int16_t));
+	if (!replacement) return 0;
+	free(capture_buffer);
+	capture_buffer = replacement;
+	capture_capacity_frames = frames;
+	capture_frame_count = 0;
+	capture_enabled = 1;
+	return 1;
+}
+
+void sound_capture_stop(void)
+{
+	capture_enabled = 0;
+}
+
+void sound_capture_release(void)
+{
+	capture_enabled = 0;
+	free(capture_buffer);
+	capture_buffer = NULL;
+	capture_capacity_frames = 0;
+	capture_frame_count = 0;
+}
+
+int sound_capture_active(void)
+{
+	return capture_enabled;
+}
+
+unsigned int sound_capture_frames(void)
+{
+	return capture_frame_count;
+}
+
+int16_t *sound_capture_data(void)
+{
+	return capture_buffer;
+}
