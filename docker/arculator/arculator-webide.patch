+		case 7: return vidc.vtot;
+		case 8: return vidc.vsync;
+		case 9: return (uint32_t)vidc.vbstart;
+		case 10: return (uint32_t)vidc.vdstart;
+		case 11: return (uint32_t)vidc.vdend;
+		case 12: return (uint32_t)vidc.vbend;
+		case 13: return (uint32_t)vidc.cx;
+		case 14: return (uint32_t)(vidc.cys >> 14);
+		case 15: return (uint32_t)(vidc.cye >> 14);
+		case 16: return (uint32_t)vidc.inter;
+		case 17: return vidc.cr;
