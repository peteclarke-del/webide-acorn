{
  "name": "8bit-net/webide-acorn-native-builder",
  "description": "Network-isolated native toolchain adapter for the Acorn Web IDE",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-ctype": "*",
    "ext-json": "*",
    "symfony/console": "^7.4",
    "symfony/framework-bundle": "^7.4",
    "symfony/process": "^7.4",
    "symfony/runtime": "^7.4",
    "symfony/yaml": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "^7.4",
    "symfony/css-selector": "^7.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit --colors=always"
  }
}
